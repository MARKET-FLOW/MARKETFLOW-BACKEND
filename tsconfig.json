{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",       // Utilise "Node" avec une majuscule
    "ignoreDeprecations": "6.0",     // Garde ceci pour passer outre l'alerte TS7.0
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": false,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "types": ["node"],
    "paths": {
      "@prisma/client": ["prisma/generated/prisma"]
    }
  }
}