{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { 
        "include": "prisma/generated/prisma/**/*", 
        "outDir": "dist/prisma/generated/prisma",
        "watchAssets": true 
      }
    ],
    "tsConfigPath": "tsconfig.build.json"
  }
}
