model Product {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId        String    @map("store_id") @db.Uuid
  categoryId     String?   @map("category_id") @db.Uuid
  createdBy      String    @map("created_by") @db.Uuid
  name           String    @db.VarChar(200)
  barcode        String?   @db.VarChar(50)
  purchasePrice  Decimal   @map("purchase_price") @db.Decimal(12, 2)
  sellingPrice   Decimal   @map("selling_price") @db.Decimal(12, 2)
  taxRate        Decimal   @default(0) @map("tax_rate") @db.Decimal(5, 2)
  stockQuantity  Int       @default(0) @map("stock_quantity")
  stockMinAlert  Int       @default(5) @map("stock_min_alert")
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @map("updated_at")

  // Relations
  store          Store           @relation(fields: [storeId], references: [id])
  category       Category?       @relation(fields: [categoryId], references: [id])
  creator        User            @relation(fields: [createdBy], references: [id])
  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@unique([storeId, barcode], name: "idx_products_store_barcode")
  @@index([storeId, categoryId], name: "idx_products_store_category") // combiné pour les filtres catalogue
  @@index([name], name: "idx_products_name")
  @@index([createdAt], name: "idx_products_created_at")
  @@map("products")
}
