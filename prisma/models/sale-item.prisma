model SaleItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId     String    @map("store_id") @db.Uuid
  saleId      String    @map("sale_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  productName String    @map("product_name") @db.VarChar(200) // snapshot — nom figé au moment de la vente
  quantity    Int
  unitPrice   Decimal   @map("unit_price") @db.Decimal(12, 2) // snapshot — prix figé
  taxRate     Decimal   @map("tax_rate") @db.Decimal(5, 2)    // snapshot — taxe figée
  subtotal    Decimal   @db.Decimal(12, 2)
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  store   Store   @relation(fields: [storeId], references: [id])
  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([storeId], name: "idx_sale_items_store")
  @@index([saleId], name: "idx_sale_items_sale")
  @@index([productId], name: "idx_sale_items_product")
  @@map("sale_items")
}
