model MobileDevice {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId     String    @map("store_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  deviceName  String    @map("device_name") @db.VarChar(100)
  deviceToken String    @unique @map("device_token") @db.VarChar(255)
  deviceType  DeviceType @map("device_type")
  role        Role
  isActive    Boolean   @default(true) @map("is_active")
  lastSeenAt  DateTime? @map("last_seen_at")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  store Store  @relation(fields: [storeId], references: [id])
  user  User   @relation(fields: [userId], references: [id])
  sales Sale[]

  @@index([deviceToken], name: "idx_devices_token")
  @@index([storeId, userId], name: "idx_devices_store_user")
  @@index([deletedAt], name: "idx_devices_deleted_at")
  @@map("mobile_devices")
}
